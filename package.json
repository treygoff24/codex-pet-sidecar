{
  "name": "codex-pet-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source local desktop pet sidecar for Codex",
  "keywords": [
    "ai",
    "codex",
    "desktop-pet",
    "macos",
    "tauri"
  ],
  "homepage": "https://github.com/treygoff24/codex-pet-sidecar#readme",
  "bugs": {
    "url": "https://github.com/treygoff24/codex-pet-sidecar/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treygoff24/codex-pet-sidecar.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "install:dev": "node scripts/dev-install.mjs",
    "release:assert-version": "node scripts/assert-release-version.mjs",
    "release:create-manifest": "node scripts/create-update-manifest.mjs",
    "release:verify-artifacts": "node scripts/verify-release-artifacts.mjs",
    "setup:python": "python3 -m venv .venv && ./.venv/bin/python -m pip install -r requirements.txt",
    "smoke:runtime": "node scripts/smoke-codex-runtime.mjs",
    "lint": "oxlint",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "oxfmt && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "oxfmt --check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "npm run lint && npm run format:check && npm run build && rm -rf dist && npm test && npm run lint:rust && cargo test --manifest-path src-tauri/Cargo.toml",
    "doctor": "node scripts/doctor.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "audit:artifacts": "node scripts/audit-artifacts.mjs",
    "verify:codex-animation": "node scripts/verify-codex-animation-parity.mjs",
    "verify:olive-row7-repair": "node scripts/verify-olive-row7-repair-workflow.mjs",
    "verify:animation-parity": "npm run verify:codex-animation && npm run verify:olive-row7-repair"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
