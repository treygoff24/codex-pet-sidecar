{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Pet Sidecar",
  "version": "0.1.0",
  "identifier": "dev.codexpet.sidecar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex Pet Sidecar",
        "width": 288,
        "height": 368,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "../assets/pets/**",
          "$APPDATA/Codex Pet Sidecar/pets/**",
          "$HOME/Library/Application Support/Codex Pet Sidecar/pets/**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../assets/pets/olive/pet.json",
      "../assets/pets/olive/personality.md",
      "../assets/pets/olive/README.md",
      "../assets/pets/olive/spritesheet.webp"
    ]
  }
}
